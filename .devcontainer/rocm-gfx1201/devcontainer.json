{
    "name": "Aether-ML (Python 3.14 + ROCm 7.14)",

    "build": {
        "dockerfile": "aether-rocm-gfx1201.Dockerfile",
        "context": "../.."
    },

    "runArgs": [
        "--device=/dev/kfd",
        "--device=/dev/dri",
        "--ipc=host",
        "--security-opt",
        "seccomp=unconfined",
        "--shm-size=16G"
    ],
    "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind",
    "workspaceFolder": "/app",

    "updateRemoteUserUID": false,
    "remoteUser": "ubuntu",

    "postStartCommand": ["sudo", "/usr/local/bin/fix-gpu-groups.sh"],
    "waitFor": "postStartCommand",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "ms-azuretools.vscode-docker"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/venv/bin/python"
            }
        }
    },

    "postCreateCommand": ["pip", "install", "--no-build-isolation", "-e", ".", "--config-settings", "editable_mode=compat"],

    "portsAttributes": {
        "8888": {
            "label": "Jupyter Lab Server",
            "onAutoForward": "notify"
        },
        "otherPorts": {
            "onAutoForward": "ignore"
        }
    }
}
